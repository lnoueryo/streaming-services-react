# ----------------------------
#  Base（pnpm + node のベース）
# ----------------------------
FROM node:20-alpine AS base
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

# ----------------------------
#  Dependencies（高速化用キャッシュ）
#  ※ node_modules はコンテナ内に置く（ホットリロードが安定する）
# ----------------------------
FROM base AS deps

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install


# ----------------------------
#  Dev Runner（ホットリロード）
# ----------------------------
FROM node:20-alpine AS dev
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@latest --activate

ENV NODE_ENV=development  
ENV NEXT_TELEMETRY_DISABLED=1

# node_modules だけ Docker 内にコピーして保持（ホスト側には置かない）
COPY --from=deps /app/node_modules ./node_modules
COPY package.json pnpm-lock.yaml* ./

# ソースコードは volume mount する前提（Docker Compose 側で）
# COPY . .  ← dev では不要（bind mount を使うため）

EXPOSE 3000
CMD ["pnpm", "dev"]